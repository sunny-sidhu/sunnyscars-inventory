@SunnysCars.Inventory.Api_HostAddress = http://localhost:5093
# Ids are MongoDB ObjectIds and differ per database: replace this with an id from "List all cars".
@carId = 6ae89b7ba121a7e475a6aea8

### List all cars
GET {{SunnysCars.Inventory.Api_HostAddress}}/v1/cars
Accept: application/json

### Get a single car
GET {{SunnysCars.Inventory.Api_HostAddress}}/v1/cars/{{carId}}
Accept: application/json

### Add a car
POST {{SunnysCars.Inventory.Api_HostAddress}}/v1/cars
Content-Type: application/json

{
  "make": "Mazda",
  "model": "MX-5",
  "colour": "Soul Red",
  "price": 22500.00,
  "year": 2022,
  "mileage": 12000,
  "transmission": "manual"
}

### Update a car
PUT {{SunnysCars.Inventory.Api_HostAddress}}/v1/cars/{{carId}}
Content-Type: application/json

{
  "make": "Nissan",
  "model": "Micra",
  "colour": "Orange",
  "price": 6995.00,
  "year": 2017,
  "mileage": 53100,
  "transmission": "manual"
}

### Delete a car
DELETE {{SunnysCars.Inventory.Api_HostAddress}}/v1/cars/{{carId}}

### Health: MongoDB status and the commit the app was built from (200 Healthy, 503 Unhealthy)
GET {{SunnysCars.Inventory.Api_HostAddress}}/health
Accept: application/json

###
